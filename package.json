{
	"name": "skysa-kit",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"test": "pnpm -r run test && vitest run",
		"typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test"
	},
	"devDependencies": {
		"@skysa/eslint-config": "workspace:*",
		"@types/node": "catalog:",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"knip": "^6.42.1",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"vitest": "catalog:"
	},
	"prettier": "@skysa/eslint-config/prettier"
}
