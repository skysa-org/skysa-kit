{
	"name": "@skysa/protocol",
	"version": "0.1.0",
	"description": "What the server, the client and a deployment all speak: the API's error codes, the entitlement, gate and rate-limit seams, the relay's frames, and the provider kinds.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/skysa-org/skysa-kit.git",
		"directory": "packages/protocol"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/*.tsbuildinfo",
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			}
		}
	},
	"scripts": {
		"prepack": "tsc -b tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@skysa/eslint-config": "workspace:*"
	}
}
