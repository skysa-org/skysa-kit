{
	"name": "@skysa/pwa",
	"version": "0.0.0",
	"description": "The brand's Vite plugin, the web app manifest and the service worker's options, and the bundle budget.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/skysa-org/skysa-kit.git",
		"directory": "packages/pwa"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/*.tsbuildinfo",
		"src",
		"scripts",
		"brand.schema.json"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./tests/testing.ts",
			"default": "./tests/testing.ts"
		},
		"./budget": "./scripts/bundleBudget.mjs",
		"./brand.schema.json": "./brand.schema.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"./testing": {
				"types": "./dist/tests/testing.d.ts",
				"default": "./dist/tests/testing.js"
			},
			"./budget": "./scripts/bundleBudget.mjs",
			"./brand.schema.json": "./brand.schema.json"
		}
	},
	"scripts": {
		"prepack": "tsc -b tsconfig.build.json tsconfig.testing.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"peerDependencies": {
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^1.3.0"
	},
	"devDependencies": {
		"@skysa/eslint-config": "workspace:*",
		"@types/node": "catalog:",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "catalog:"
	}
}
