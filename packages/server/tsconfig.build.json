{
	// What is published: src, built to dist/src with its declarations by
	// `pnpm build`. The Worker's own code alone, with no ambient Node types:
	// it runs without `nodejs_compat`, so `Buffer`, `process` or
	// `setImmediate` there would pass `tsconfig.json` (whose tests pull
	// @types/node in through vitest) and only fail once deployed.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"noEmit": false,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["src/**/*.ts"],
	"references": [
		{ "path": "../protocol/tsconfig.build.json" },
		{ "path": "../storage/tsconfig.build.json" }
	]
}
