{
	"name": "@skysa/storage",
	"version": "0.2.0",
	"description": "The storage adapter interface and its errors, one adapter per provider, and below them names, paths, the marker and hashing.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/skysa-org/skysa-kit.git",
		"directory": "packages/storage"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/*.tsbuildinfo",
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./tests/testing.ts",
			"default": "./tests/testing.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"./testing": {
				"types": "./dist/tests/testing.d.ts",
				"default": "./dist/tests/testing.js"
			}
		}
	},
	"scripts": {
		"prepack": "tsc -b tsconfig.build.json tsconfig.testing.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@skysa/protocol": "workspace:*",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@skysa/eslint-config": "workspace:*",
		"@types/node": "catalog:",
		"vitest": "catalog:"
	}
}
