{
	"name": "@skysa/sync",
	"version": "0.0.0",
	"description": "The sync engine and its store port, over a document format the app supplies.",
	"private": true,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/skysa-org/skysa-kit.git",
		"directory": "packages/sync"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./tests/testing.ts",
			"default": "./tests/testing.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@skysa/storage": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"vitest": "catalog:"
	}
}
